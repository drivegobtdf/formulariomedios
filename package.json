{
  "name": "formulariomedios-root",
  "version": "0.1.0-beta2",
  "private": true,
  "type": "module",
  "description": "Sistema PEDIDOS — Secretaría de Medios (Gobierno de Tierra del Fuego AIAS) - Monorepo & Toolchain",
  "engines": {
    "node": ">=20.12.0"
  },
  "workspaces": [
    "pedidos-medios/frontend"
  ],
  "scripts": {
    "dev": "npm --workspace=pedidos-medios-frontend run dev",
    "dev:preview": "npm --workspace=pedidos-medios-frontend run dev:preview",
    "dev:preview:cloud": "npm --workspace=pedidos-medios-frontend run dev:preview:cloud",
    "build": "npm --workspace=pedidos-medios-frontend run build",
    "build:preview": "npm --workspace=pedidos-medios-frontend run build:preview",
    "build:preview:cloud": "npm --workspace=pedidos-medios-frontend run build:preview:cloud",
    "build:wordpress": "npm --workspace=pedidos-medios-frontend run build:wordpress",
    "package:wordpress": "node scripts/package-wordpress.mjs",
    "build:standalone": "npm --workspace=pedidos-medios-frontend run build:standalone && node scripts/postbuild-standalone.mjs",
    "preview:standalone": "node scripts/preview-standalone.mjs",
    "package:standalone": "node scripts/package-standalone.mjs",
    "preview": "npm --workspace=pedidos-medios-frontend run preview",
    "preview:cloud": "npm --workspace=pedidos-medios-frontend run preview:cloud",
    "typecheck": "npm --workspace=pedidos-medios-frontend run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:php": "node scripts/lint-php.js",
    "test:db": "supabase test db",
    "test:auth-integration": "vitest run tests/integration/auth-local.test.ts",
    "test:submission-concurrency": "vitest run tests/integration/submission-concurrency-local.test.ts",
    "test:drive-integration": "vitest run tests/integration/drive-upload-local.test.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "supabase": "supabase",
    "supabase:status": "supabase status",
    "google:bootstrap": "node scripts/google-drive-oauth-bootstrap.js",
    "verify:closure:f7-f9": "node scripts/verify-closure-f7-f9.js",
    "verify:closure:f10": "node scripts/verify-closure-f10.js",
    "dispatch:comunicaciones": "node scripts/comunicaciones-dispatch.mjs",
    "start:scheduler": "node scripts/comunicaciones-scheduler-daemon.mjs",
    "status:scheduler": "node scripts/comunicaciones-scheduler-daemon.mjs --status"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.9",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.3",
    "supabase": "^2.15.8",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^5.0.0"
  }
}
