{
  "name": "pedidos-medios-frontend",
  "version": "0.1.0-alpha",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:preview": "vite --mode preview",
    "dev:preview:cloud": "vite --mode preview-cloud",
    "build": "tsc && vite build",
    "build:preview": "tsc && vite build --mode preview",
    "build:preview:cloud": "tsc && vite build --mode preview-cloud",
    "preview": "vite preview",
    "preview:cloud": "npm run build:preview:cloud && vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "libphonenumber-js": "^1.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.7.3",
    "vite": "^8.3.0"
  }
}
