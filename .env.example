# ==============================================================================
# PEDIDOS — Secretaría de Medios (Revisión 3.0)
# Variables de entorno públicas para desarrollo frontend y skeleton
# IMPORTANTE: Nunca colocar claves con privilegios de servicio (service_role)
# ni secretos de Google Drive o n8n en el frontend.
# ==============================================================================

# Supabase (Configuración pública del cliente)
VITE_SUPABASE_URL=https://placeholder-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_placeholder_anon_key_for_development_only

# Entorno de ejecución (development | staging | production)
VITE_ENVIRONMENT=development

# Base path del Router en WordPress
VITE_BASE_PATH=/formulariomedios

# Versión del contrato de integración
VITE_CONTRACT_VERSION=3.0

# Puerto del servidor de desarrollo local de Vite
PORT=5173
